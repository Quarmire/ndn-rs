# C9-01 fixture — vendor B: translates A's kind into its own, declaring the
# rounding it costs.
stratum vendor-b "Vendor B's world, plus its declared translation from A."

use vendor-a as va

term b "Vendor B's reading kind."
term rounding "Loss: values rounded to B's coarser grid crossing A→B."

maps-to va:a -> b @loss = rounding
