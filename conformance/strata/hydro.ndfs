# hydro — the Riverwatch stratum, kernel-form (riverwatch-manifest-contract §III;
# the page's JSON is "corpus-shaped, not corpus-ratified" — this is the ratified-calculus rendering, F38)
stratum hydro "Flood-sentinel vocabulary: stations, observations, alerts, health. pylon-7 publishes meaning, not pixels; every lens resolves its own way of showing it."

use units as units
use measured as m
use quality as q
use edge-kinds as e

enum stage "Flood stages, in rising order (the station's declared thresholds give each a level)." { action minor moderate major }
enum trend "Which way the water is going." { rising cresting falling }

record station "Station identity: everything a lens needs to be honest — units, precision, datum, thresholds — signed before the first reading ships." {
    name : name "The station's NDN name (e.g. /basin/rio-verde/gauge/pylon-7)."
    operator : name "The operating organization."
    gauge-zero-m : decimal @unit = units:metre "Gauge zero above the vertical datum — the datum lives HERE, never in a renderer."
    datum : text "The vertical datum (e.g. NAVD88)."
    stage-action-m : decimal @unit = units:metre "Action stage threshold."
    stage-minor-m : decimal @unit = units:metre "Minor flood stage threshold."
    stage-moderate-m : decimal @unit = units:metre "Moderate flood stage threshold."
    stage-major-m : decimal @unit = units:metre "Major flood stage threshold."
}

record observation "One signed hourly reading. Corrections supersede via the chain; nothing is overwritten." {
    t : m:instant "Reading time."
    stage-m : m:measured @unit = units:metre "Water stage against the station's declared datum."
    rain-mm-1h : m:measured @unit = units:millimetre "Rain in the trailing hour."
    turbidity-ntu : optional m:measured @unit = units:ntu "Turbidity, when the probe is healthy."
    quality : term-of q:quality "Reading quality."
}

record alert "A stage-crossing alert. Says what is true and how urgently; every surface decides — under contract — what attention looks like there. No color, no icon, no siren tone." {
    stage-crossed : term-of stage "Which threshold was crossed."
    stage-m : m:measured @unit = units:metre "The reading that crossed it."
    trend : term-of trend "Direction."
    valid-for-s : integer "Validity window in seconds."
    evidence : some hash "Cited observations (≥3 enforced by the co-domain's validators; ≥1 by cardinality here)."
}

record health "Housekeeping: batteries and faults. No lens is obliged to show it; fault.attention may still interrupt the maintainer." {
    battery-v : m:measured @unit = units:volt "Battery voltage."
    solar-w : m:measured @unit = units:watt "Solar input."
    flash-pct : decimal @unit = units:percent "Flash used."
    faults : many text "Faulting sensors, by name."
    uptime-s : integer "Seconds since boot."
}

term calibration "A calibration record anchoring an instrument's scale."

edge alert e:is-derived-from observation
edge observation e:is-measured-by station
edge observation e:is-calibrated-by calibration
edge health e:is-status-of station
edge observation e:is-input-of alert
