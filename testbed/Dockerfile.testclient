# Testbed client image.
#
# Contains:
#   - ndn-rs tools (built from source): ndn-iperf, ndn-ping, ndn-peek,
#     ndn-put, ndn-sec, ndn-ctl
#
# Uses cargo-chef for dependency layer caching.  See binaries/ndn-fwd/Dockerfile
# for a full explanation of the planner → cacher → builder pattern.
#
# Build (from repo root):
#   docker build -f testbed/Dockerfile.testclient -t ndn-testclient .

# ── Stage 1: chef base ────────────────────────────────────────────────────────
FROM rust:slim AS chef

RUN cargo install cargo-chef --locked

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libdbus-1-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# ── Stage 2: planner ──────────────────────────────────────────────────────────
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# ── Stage 3: cacher ───────────────────────────────────────────────────────────
FROM chef AS cacher
COPY --from=planner /build/recipe.json recipe.json
RUN cargo chef cook --release \
    --bin ndn-iperf \
    --bin ndn-ping \
    --bin ndn-peek \
    --bin ndn-put \
    --bin ndn-sec \
    --bin ndn-ctl \
    --recipe-path recipe.json

# ── Stage 4: builder ──────────────────────────────────────────────────────────
FROM chef AS builder
COPY . .
COPY --from=cacher /build/target target
RUN cargo build --release \
    --bin ndn-iperf \
    --bin ndn-ping \
    --bin ndn-peek \
    --bin ndn-put \
    --bin ndn-sec \
    --bin ndn-ctl

# ── Stage 5: runtime image ────────────────────────────────────────────────────
FROM debian:trixie-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    netcat-openbsd \
    jq \
    bc \
    curl \
    tcpdump \
    tshark \
    iproute2 \
  && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/ndn-iperf  /usr/local/bin/
COPY --from=builder /build/target/release/ndn-ping   /usr/local/bin/
COPY --from=builder /build/target/release/ndn-peek   /usr/local/bin/
COPY --from=builder /build/target/release/ndn-put    /usr/local/bin/
COPY --from=builder /build/target/release/ndn-sec    /usr/local/bin/
COPY --from=builder /build/target/release/ndn-ctl    /usr/local/bin/

COPY testbed/tests  /testbed/tests
COPY testbed/bench  /testbed/bench

RUN chmod +x /testbed/tests/compliance/*.sh /testbed/bench/*.sh 2>/dev/null || true

WORKDIR /testbed
