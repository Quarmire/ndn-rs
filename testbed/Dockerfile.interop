# Interoperability test client image.
#
# Contains:
#   - ndn-cxx tools: ndnpeek, ndnpoke, ndnping, nfdc
#   - NFD AutoConfig tools: ndn-autoconfig, ndn-autoconfig-server
#   - NDNts CLI: ndncat (from @ndn/cat)
#   - ndn-rs tools (built from source): ndn-peek, ndn-put, ndn-ping, ndn-iperf,
#     ndn-ctl, ndn-mgmt-response-verify, ndn-mgmt-notification-fetch
FROM ubuntu:24.04 AS ndn-cxx-builder

ARG BUILD_JOBS=2

# ndn-cxx deps (per named-data getting started guide)
# cmake also needed to build ndn-tools-24.07 against the waf-installed ndn-cxx
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake pkg-config python3 \
    libboost-all-dev libssl-dev libsqlite3-dev \
    libpcap-dev libsystemd-dev \
    ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

# Install to /usr so the library lands in /usr/lib (always in ldconfig search
# path on all distros) rather than /usr/local/lib which requires explicit config.
RUN git clone --depth 1 \
      https://github.com/named-data/ndn-cxx.git /src/ndn-cxx && \
    cd /src/ndn-cxx && \
    ./waf configure --prefix=/usr && \
    ./waf build -j"${BUILD_JOBS}" && \
    ./waf install

# ndn-tools 24.07 (waf build)
RUN git clone --depth 1 --branch ndn-tools-24.07 \
      https://github.com/named-data/ndn-tools.git /src/ndn-tools && \
    cd /src/ndn-tools && \
    ./waf configure --prefix=/usr && \
    ./waf build -j"${BUILD_JOBS}" && \
    ./waf install

# Build only the NFD AutoConfig tool targets, not the whole daemon. The G.06
# witness needs the reference procedure client/server, while the runtime NFD
# image already supplies `nfdc`.
RUN git clone --depth 1 \
      https://github.com/named-data/NFD.git /src/NFD && \
    cd /src/NFD && \
    ./waf configure --prefix=/usr --without-systemd --without-websocket && \
    ./waf build -j"${BUILD_JOBS}" --targets=version.cpp,version.hpp && \
    ./waf build -j"${BUILD_JOBS}" --targets=ndn-autoconfig,ndn-autoconfig-server

# PSync C++ reference library and examples for G.03 live interop.
RUN git clone --depth 1 \
      https://github.com/named-data/PSync.git /src/PSync && \
    cd /src/PSync && \
    ./waf configure --prefix=/usr --with-examples && \
    ./waf build -j"${BUILD_JOBS}" && \
    ./waf install
COPY testbed/tools/psync-deterministic-producer.cpp /src/psync-deterministic-producer.cpp
RUN g++ -std=c++17 -O2 -Wall -Wextra \
      /src/psync-deterministic-producer.cpp \
      -o /usr/bin/psync-deterministic-producer \
      $(pkg-config --cflags --libs PSync libndn-cxx) \
      -lboost_iostreams -pthread

# Reference NFD runtime tools. We build ndn-cxx/ndn-tools locally above, but
# `nfdc` is part of NFD itself rather than ndn-tools. Copy it from the
# published reference image and run it against the locally copied ndn-cxx ABI.
FROM ghcr.io/named-data/nfd:latest AS nfd-runtime

# ── ndn-rs tools: chef base ───────────────────────────────────────────────────
# Uses cargo-chef for dependency layer caching.  See binaries/ndn-fwd/Dockerfile
# for a full explanation of the planner → cacher → builder pattern.
FROM rust:slim AS ndn-rs-chef

ARG BUILD_JOBS=2
ENV CARGO_BUILD_JOBS=${BUILD_JOBS}

RUN cargo install cargo-chef --locked

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libdbus-1-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# ── ndn-rs tools: planner ─────────────────────────────────────────────────────
FROM ndn-rs-chef AS ndn-rs-planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# ── ndn-rs tools: cacher ──────────────────────────────────────────────────────
FROM ndn-rs-chef AS ndn-rs-cacher
COPY --from=ndn-rs-planner /build/recipe.json recipe.json
RUN cargo chef cook --release \
    --bin ndn-peek \
    --bin ndn-put \
    --bin ndn-ping \
    --bin ndn-iperf \
    --bin ndn-ctl \
    --bin ndn-mgmt-response-verify \
    --bin ndn-mgmt-notification-fetch \
    --bin ndn-psync-consumer \
    --bin ndn-safebag-witness \
    --bin enroll-ndncert \
    --recipe-path recipe.json

# ── ndn-rs tools: builder ─────────────────────────────────────────────────────
FROM ndn-rs-chef AS ndn-rs-builder
COPY . .
COPY --from=ndn-rs-cacher /build/target target
RUN cargo build --release \
    -j "${CARGO_BUILD_JOBS}" \
    --bin ndn-peek \
    --bin ndn-put \
    --bin ndn-ping \
    --bin ndn-iperf \
    --bin ndn-ctl \
    --bin ndn-mgmt-response-verify \
    --bin ndn-mgmt-notification-fetch \
    --bin ndn-psync-consumer \
    --bin ndn-safebag-witness \
    --bin enroll-ndncert

# ── Final image ───────────────────────────────────────────────────────────────
FROM ubuntu:24.04

# Runtime libs for ndn-cxx tools.
# libssl3, libsqlite3-0, libpcap0.8: direct ndn-cxx runtime deps.
# Boost: copy ALL versioned .so files from the builder stage rather than
# enumerating packages (avoids missing e.g. libboost_stacktrace_backtrace).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 libsqlite3-0 libpcap0.8 \
    curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Node.js 24 from NodeSource. Current @ndn/cat pulls packages that require
# iterator helpers unavailable in Node 20 and advertise Node 24+ engines; keep
# the runtime aligned with the CLI before packet-level interop begins.
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

RUN --mount=type=bind,from=ndn-cxx-builder,source=/,target=/builder \
    find /builder/usr/lib -name "libboost_*.so.*" -type f \
         -exec cp {} /usr/lib/ \; && ldconfig

# ndn-cxx tools — binaries from /usr/bin (prefix=/usr build)
COPY --from=ndn-cxx-builder /usr/bin/ndnsec    /usr/local/bin/
COPY --from=ndn-cxx-builder /usr/bin/ndnpeek   /usr/local/bin/
COPY --from=ndn-cxx-builder /usr/bin/ndnpoke   /usr/local/bin/
COPY --from=ndn-cxx-builder /usr/bin/ndnping   /usr/local/bin/
COPY --from=ndn-cxx-builder /src/NFD/build/bin/ndn-autoconfig /usr/local/bin/
COPY --from=ndn-cxx-builder /src/NFD/build/bin/ndn-autoconfig-server /usr/local/bin/
COPY --from=nfd-runtime /usr/bin/nfdc /usr/local/bin/
COPY --from=ndn-cxx-builder /src/PSync/build/examples/psync-full-sync /usr/local/bin/
COPY --from=ndn-cxx-builder /usr/bin/psync-deterministic-producer /usr/local/bin/
# ndn-cxx shared library — find wherever waf installed it in the builder and
# copy to /usr/lib/ (always in ldconfig search path).  Fail the build loudly
# if the library is missing so we get a clear signal, not a silent runtime error.
RUN --mount=type=bind,from=ndn-cxx-builder,source=/,target=/builder \
    sh -c ' \
      LIB=$(find /builder -name "libndn-cxx.so.0.9.0" -type f 2>/dev/null | head -1); \
      if [ -z "${LIB}" ]; then \
        echo "BUILD ERROR: libndn-cxx.so.0.9.0 not found anywhere in builder" >&2; \
        find /builder/usr -name "libndn-cxx*" 2>/dev/null; \
        exit 1; \
      fi; \
      echo "Found library at: ${LIB}"; \
      cp "${LIB}" /usr/lib/; \
    ' && ldconfig

RUN --mount=type=bind,from=ndn-cxx-builder,source=/,target=/builder \
    sh -c ' \
      LIB=$(find /builder -name "libPSync.so*" -type f 2>/dev/null | head -1); \
      if [ -z "${LIB}" ]; then \
        echo "BUILD ERROR: libPSync.so not found anywhere in builder" >&2; \
        find /builder/usr -name "libPSync*" 2>/dev/null; \
        exit 1; \
      fi; \
      echo "Found PSync library at: ${LIB}"; \
      cp "${LIB}" /usr/lib/; \
    ' && ldconfig

# NDNts CLI tools — @ndn/cat provides the `ndncat` binary used by interop tests.
# This image exists specifically for cross-implementation testing, so missing
# peer tools are build failures rather than runtime skips.
RUN npm install -g @ndn/cat --legacy-peer-deps

# ndn-rs tools
COPY --from=ndn-rs-builder /build/target/release/ndn-peek       /usr/local/bin/
COPY --from=ndn-rs-builder /build/target/release/ndn-put        /usr/local/bin/
COPY --from=ndn-rs-builder /build/target/release/ndn-ping       /usr/local/bin/
COPY --from=ndn-rs-builder /build/target/release/ndn-iperf      /usr/local/bin/
COPY --from=ndn-rs-builder /build/target/release/ndn-ctl        /usr/local/bin/
COPY --from=ndn-rs-builder /build/target/release/ndn-mgmt-response-verify /usr/local/bin/
COPY --from=ndn-rs-builder /build/target/release/ndn-mgmt-notification-fetch /usr/local/bin/
COPY --from=ndn-rs-builder /build/target/release/ndn-psync-consumer /usr/local/bin/
COPY --from=ndn-rs-builder /build/target/release/ndn-safebag-witness /usr/local/bin/
COPY --from=ndn-rs-builder /build/target/release/enroll-ndncert /usr/local/bin/

RUN command -v ndnsec >/dev/null && \
    ndnsec help >/dev/null && \
    command -v ndnpeek >/dev/null && \
    command -v ndnpoke >/dev/null && \
    command -v ndnping >/dev/null && \
    command -v ndn-autoconfig >/dev/null && \
    command -v ndn-autoconfig-server >/dev/null && \
    command -v nfdc >/dev/null && \
    nfdc --version >/dev/null && \
    command -v psync-full-sync >/dev/null && \
    command -v psync-deterministic-producer >/dev/null && \
    command -v ndncat >/dev/null && \
    ndncat --help >/dev/null && \
    command -v ndn-peek >/dev/null && \
    command -v ndn-put >/dev/null && \
    command -v ndn-ping >/dev/null && \
    command -v ndn-iperf >/dev/null && \
    command -v ndn-ctl >/dev/null && \
    command -v ndn-mgmt-response-verify >/dev/null && \
    command -v ndn-mgmt-notification-fetch >/dev/null && \
    command -v ndn-psync-consumer >/dev/null && \
    command -v ndn-safebag-witness >/dev/null && \
    command -v enroll-ndncert >/dev/null

COPY testbed/tests/interop/ /testbed/tests/interop/
RUN chmod +x /testbed/tests/interop/*.sh

WORKDIR /testbed
