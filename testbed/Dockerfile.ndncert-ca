# syntax=docker/dockerfile:1
# Build the ndncert-ca-server binary from the upstream named-data/ndncert source.
#
# Used when ghcr.io/named-data/ndncert is unavailable.  Mirrors the build
# pattern in the upstream Dockerfile (named-data/ndncert), but clones from
# GitHub so the build is self-contained and works in CI without a local checkout.
#
# Target: ca — ships ndncert-ca-server and ndncert-ca-status.

FROM ghcr.io/named-data/ndn-cxx-build:latest AS build

RUN git clone --depth 1 https://github.com/named-data/ndncert /src/ndncert

RUN cd /src/ndncert && \
    ./waf configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --sharedstatedir=/var && \
    ./waf build -j"$(nproc)" && \
    ./waf install

FROM ghcr.io/named-data/ndn-cxx-runtime:latest

COPY --from=build /usr/lib/libndn-cert.so.* /usr/lib/
COPY --from=build /usr/bin/ndncert-ca-server /usr/bin/
COPY --from=build /usr/bin/ndncert-ca-status /usr/bin/

RUN apt-get install -Uy --no-install-recommends python3 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV HOME=/config
VOLUME /config
VOLUME /run/nfd

ENTRYPOINT ["/bin/bash", "/config/entrypoint.sh"]
